{
  "name": "backrow",
  "version": "0.0.0",
  "private": true,
  "description": "Backrow — serverless real-time audience engagement platform on AWS.",
  "workspaces": [
    "packages/*",
    "infra"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "jest",
    "synth": "npm run synth --workspace infra",
    "deploy:dev": "npm run deploy:dev --workspace infra",
    "build:harness": "esbuild packages/client/src/index.ts --bundle --format=esm --target=es2022 --sourcemap --outfile=apps/harness/client.js",
    "harness": "npm run build:harness && node scripts/serve-harness.mjs",
    "deploy:ci-role": "npm run deploy:ci-role --workspace infra",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "aws-sdk-client-mock": "^4.0.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "typescript": "^5.5.3"
  }
}
