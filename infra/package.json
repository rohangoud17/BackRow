    "@types/jest": "^29.5.12",
    "aws-cdk": "^2.150.0",
    "esbuild": "^0.21.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2"
  }
}
