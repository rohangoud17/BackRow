# Make line-ending handling explicit and identical for every developer,
# rather than depending on each machine's core.autocrlf setting. Without
# this, a Windows dev and a macOS/Linux dev can see spurious whole-file
# diffs where nothing actually changed.

# Default: let Git decide what's text, and store text as LF in the repo.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or they misbehave.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must keep LF or they fail to execute on Linux
# (a CRLF shebang line produces "bad interpreter").
*.sh text eol=lf

# Lockfiles: text, but never show them in diffs — they're generated.
package-lock.json text eol=lf linguist-generated=true

# Binary files Git must not touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
