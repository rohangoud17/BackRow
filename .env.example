# Copy to .env for local work. Never commit real values (.env is gitignored).
# Phase 0 needs almost nothing locally — CDK reads AWS creds from your shell.

# AWS profile/region used by the CDK CLI for `npm run deploy:dev`.
AWS_PROFILE=backrow-dev
AWS_REGION=us-east-1

# Deployment environment name (also settable via `cdk --context env=dev`).
ENVIRONMENT=dev
